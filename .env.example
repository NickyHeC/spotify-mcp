# Spotify OAuth Configuration
OAUTH_ENABLED=true
OAUTH_AUTHORIZE_URL=https://accounts.spotify.com/authorize
OAUTH_TOKEN_URL=https://accounts.spotify.com/api/token
OAUTH_CLIENT_ID=your-spotify-client-id
OAUTH_CLIENT_SECRET=your-spotify-client-secret
OAUTH_SCOPES_AVAILABLE=user-read-playback-state,user-modify-playback-state,user-read-currently-playing,playlist-read-private,playlist-read-collaborative,playlist-modify-private,playlist-modify-public,user-top-read,user-read-recently-played,user-library-modify,user-library-read,user-read-email,user-read-private
OAUTH_BASE_URL=https://api.spotify.com

# Dedalus Authorization Server (optional override)
# DEDALUS_AS_URL=https://as.dedaluslabs.ai

# Server configuration (optional)
# PORT=8080
# HOST=0.0.0.0
